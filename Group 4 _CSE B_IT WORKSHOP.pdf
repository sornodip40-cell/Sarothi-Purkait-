BT 1 0 0 1 5 501.7 Tm /F4 6.7 Tf 8.2 TL (def write_file\(filepath, text\):) Tj T* (    """Save text as UTF-8.""") Tj T* (    Path\(filepath\).write_text\(text, encoding="utf-8"\)) Tj T*  T* (def get_text_from_user\(\):) Tj T* (    print\("Enter text \(one line\):"\)) Tj T* (    return input\("> "\)) Tj T*  T* (def show_menu\(\):) Tj T* (    print\("\\\\n====== TEXT CLEANING & SEARCH UTILITY ======"\)) Tj T* (    print\("1. Clean extra whitespace"\)) Tj T* (    print\("2. Normalize text"\)) Tj T* (    print\("3. Count characters and words"\)) Tj T* (    print\("4. Search for a word or phrase"\)) Tj T* (    print\("5. Slice text by indexes"\)) Tj T* (    print\("6. Compare two text strings"\)) Tj T* (    print\("7. Load text from a file"\)) Tj T* (    print\("8. Save current text to a file"\)) Tj T* (    print\("9. Display current text"\)) Tj T* (    print\("0. Exit"\)) Tj T* (    print\("============================================"\)) Tj T*  T* (def main\(\):) Tj T* (    current_text = "") Tj T* (    running = True) Tj T* (    while running:) Tj T* (        show_menu\(\)) Tj T* (        choice = input\("Choose an option: "\).strip\(\)) Tj T* (        try:) Tj T* (            if choice == "1":) Tj T* (                current_text = clean_text\(get_text_from_user\(\)\)) Tj T* (                print\("Cleaned text:", current_text\)) Tj T* (            elif choice == "2":) Tj T* (                current_text = get_text_from_user\(\)) Tj T* (                lower = input\("Convert to lowercase? \(y/n\): "\).strip\(\).lower\(\) == "y") Tj T* (                punctuation = input\("Remove punctuation? \(y/n\): "\).strip\(\).lower\(\) == "y") Tj T* (                current_text = normalize_text\(current_text, lower, punctuation\)) Tj T* (                print\("Normalized text:", current_text\)) Tj T* (            elif choice == "3":) Tj T* (                current_text = get_text_from_user\(\)) Tj T* (                counts = count_text\(current_text\)) Tj T* (                print\("Characters:", counts["characters"]\)) Tj T* (                print\("Characters without spaces:", counts["characters_without_spaces"]\)) Tj T* (                print\("Words:", counts["words"]\)) Tj T* (            elif choice == "4":) Tj T* (                if not current_text:) Tj T* (                    current_text = get_text_from_user\(\)) Tj T* (                query = input\("Search for: "\)) Tj T* (                positions = search_text\(current_text, query\)) Tj T* (                if positions:) Tj T* (                    print\("Found at index position\(s\):", positions\)) Tj T* (                else:) Tj T* (                    print\("No match found."\)) Tj T* (            elif choice == "5":) Tj T* (                if not current_text:) Tj T* (                    current_text = get_text_from_user\(\)) Tj T* (                start = int\(input\("Start index: "\)\)) Tj T* (                end = int\(input\("End index \(exclusive\): "\)\)) Tj T* (                print\("Sliced text:", slice_text\(current_text, start, end\)\)) Tj T* (            elif choice == "6":) Tj T* (                first = get_text_from_user\(\)) Tj T* (                second = input\("Enter second text: "\)) Tj T* ET
