0 0 0 rg
BT 1 0 0 1 5 493.5 Tm /F4 6.7 Tf 8.2 TL (""") Tj T* (TEXT CLEANING & SEARCH UTILITY) Tj T* (Menu-driven Python console mini-project.) Tj T* (""") Tj T* (import re) Tj T* (from pathlib import Path) Tj T*  T* (def clean_text\(text\):) Tj T* (    """Trim outer spaces and collapse repeated whitespace.""") Tj T* (    return re.sub\(r"\\s+", " ", text\).strip\(\)) Tj T*  T* (def normalize_text\(text, lowercase=True, remove_punctuation=False\):) Tj T* (    """Normalize whitespace, optionally lowercase/remove punctuation.""") Tj T* (    result = clean_text\(text\)) Tj T* (    if lowercase:) Tj T* (        result = result.lower\(\)) Tj T* (    if remove_punctuation:) Tj T* (        result = re.sub\(r"[^\\w\\s]", "", result\)) Tj T* (    return result) Tj T*  T* (def count_text\(text\):) Tj T* (    """Return character count, non-whitespace count, and word count.""") Tj T* (    return {) Tj T* (        "characters": len\(text\),) Tj T* (        "characters_without_spaces": len\(re.sub\(r"\\s", "", text\)\),) Tj T* (        "words": len\(text.split\(\)\)) Tj T* (    }) Tj T*  T* (def search_text\(text, query, case_sensitive=False\):) Tj T* (    """Return starting positions of non-overlapping query occurrences.""") Tj T* (    if query == "":) Tj T* (        raise ValueError\("Search text cannot be empty."\)) Tj T* (    source = text if case_sensitive else text.lower\(\)) Tj T* (    target = query if case_sensitive else query.lower\(\)) Tj T* (    positions = []) Tj T* (    start = 0) Tj T* (    while True:) Tj T* (        index = source.find\(target, start\)) Tj T* (        if index == -1:) Tj T* (            break) Tj T* (        positions.append\(index\)) Tj T* (        start = index + max\(1, len\(target\)\)) Tj T* (    return positions) Tj T*  T* (def slice_text\(text, start, end\):) Tj T* (    """Return a validated slice; end index is exclusive.""") Tj T* (    if start < 0 or end < 0:) Tj T* (        raise ValueError\("Slice indexes must be non-negative."\)) Tj T* (    if start > end:) Tj T* (        raise ValueError\("Start index must not exceed end index."\)) Tj T* (    return text[start:end]) Tj T*  T* (def compare_text\(first, second\):) Tj T* (    """Compare exact strings and strings after normalization.""") Tj T* (    exact_match = first == second) Tj T* (    normalized_match = normalize_text\(first\) == normalize_text\(second\)) Tj T* (    return exact_match, normalized_match) Tj T*  T* (def read_file\(filepath\):) Tj T* (    """Read a UTF-8 text file.""") Tj T* (    return Path\(filepath\).read_text\(encoding="utf-8"\)) Tj T* ET
Q
 

